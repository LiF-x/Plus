    {
      "id": "single_world_formula",
      "origin_file": "mods/LifXXLNavMesh/mod.cs",
      "excerpts": [
        {
          "first_line": 18,
          "last_line": 24,
          "text": "    function LifXXLNavMesh::setup(%this)\n    {\n        LiFx::registerCallback(\n            $LiFx::hooks::onInitServerCallbacks,\n            \"configureBounds\",\n            LifXXLNavMesh);\n    }"
        },
        {
          "first_line": 26,
          "last_line": 41,
          "text": "    function LifXXLNavMesh::configureBounds(%this)\n    {\n        %countX = $cm_config::Server::TerrainXCount;\n        %countY = $cm_config::Server::TerrainYCount;\n        if (%countX != %countY || (%countX != 3 && %countX != 5 && %countX != 9))\n        {\n            error(\"LifXXLNavMesh: unsupported terrain layout\" SPC %countX @ \"x\" @ %countY);\n            quit();\n            return;\n        }\n        if (!isObject(GlobalNavMesh))\n        {\n            error(\"LifXXLNavMesh: GlobalNavMesh is missing during server initialization.\");\n            quit();\n            return;\n        }"
        },
        {
          "first_line": 46,
          "last_line": 49,
          "text": "        %halfX = %countX * 1024 - 6;\n        %halfY = %countY * 1024 - 6;\n        %centerX = 0;\n        %centerY = 0;"
        },
        {
          "first_line": 75,
          "last_line": 84,
          "text": "        GlobalNavMesh.setScale(%halfX SPC %halfY SPC 500);\n        %box = GlobalNavMesh.getWorldBox();\n        if (getWord(%box, 0) != %centerX - %halfX || getWord(%box, 1) != %centerY - %halfY ||\n            getWord(%box, 2) != 1000 || getWord(%box, 3) != %centerX + %halfX ||\n            getWord(%box, 4) != %centerY + %halfY || getWord(%box, 5) != 2000)\n        {\n            error(\"LifXXLNavMesh: unexpected world bounds after setScale:\" SPC %box);\n            quit();\n            return;\n        }"
        }
      ]
    },
    {
      "id": "cache_header_and_single_world_formula",
      "origin_file": "tools/navmesh_cache.py",
      "excerpts": [
        {
          "first_line": 15,
          "last_line": 25,
          "text": "HEADER = struct.Struct(\"<III5fII\")\nMAGIC = 0x4D534554\nVERSION = 4\n\n\ndef world_half_extent(terrain_size: int) -> int:\n    # Same contract as LifXXLNavMesh::configureBounds (2048-unit terrain, inset 6).\n    if terrain_size not in (3, 5, 9):\n        raise ValueError(f\"unsupported navigation terrain size: {terrain_size}\")\n    return terrain_size * 1024 - 6\n"
        }
      ]
