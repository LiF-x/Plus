          "text": "new NavMesh(GlobalNavMesh)\n{\n    .position = \"0 0 1500\";\n    .scale = \"3066 3066 500\";\n    .actorRadius = 2;\n    .actorClimb = 1;\n    .walkableSlope = 50;\n};"
