      "excerpts": [
        {
          "first_line": 16,
          "last_line": 30,
          "text": "        // YO dedicated server 1.4.4.5. These are the two BtWorld constructor\n        // input vectors, not the bounds of an already constructed broadphase.\n        constexpr std::uintptr_t kBoundsRva = 0x789020;\n        constexpr std::uintptr_t kBoundsLoadsRva = 0x14E18D;\n        constexpr std::array<std::uint8_t, 24> kExpectedBoundsLoads = {\n            0x0F, 0x28, 0x05, 0x9C, 0xAE, 0x63, 0x00,\n            0x0F, 0x29, 0x44, 0x24, 0x70,\n            0x0F, 0x28, 0x0D, 0x80, 0xAE, 0x63, 0x00,\n            0x0F, 0x29, 0x4C, 0x24, 0x60\n        };\n        using Bounds = std::array<float, 8>;\n        constexpr Bounds kOriginalBounds = {\n            6144.0f, 6144.0f, 2000.0f, 0.0f,\n            -6144.0f, -6144.0f, -1000.0f, 0.0f\n        };"
        }
      ]
    },
    {
      "id": "uniform_configuration",
      "origin_file": "captainHook/server/hooks/engine/hook_physics_world_bounds.cpp",
      "excerpts": [
        {
          "first_line": 106,
          "last_line": 130,
          "text": "        const auto* section = root->FirstChildElement(\"physicsWorldBounds\");\n        if (section == nullptr)\n            return true;\n        bool enabled = false;\n        if (section->QueryBoolAttribute(\"enabled\", &enabled) != tinyxml2::XML_SUCCESS)\n        {\n            CaptainHook::ShowErrorMessage(\"physicsWorldBounds requires enabled=true or false.\");\n            return false;\n        }\n        if (!enabled)\n            return true;\n\n        float extent = 0.0f;\n        if (section->QueryFloatAttribute(\"halfExtentXY\", &extent) != tinyxml2::XML_SUCCESS\n            || !std::isfinite(extent) || extent <= 6144.0f || extent > 65536.0f)\n        {\n            CaptainHook::ShowErrorMessage(\n                \"Invalid physicsWorldBounds halfExtentXY. Expected a finite value greater than 6144 and at most 65536.\");\n            return false;\n        }\n        gBounds.configured[0] = gBounds.configured[1] = extent;\n        gBounds.configured[4] = gBounds.configured[5] = -extent;\n        gBounds.enabled = true;\n        return true;\n    }"
        }
      ]
    },
    {
      "id": "guarded_startup_and_restore",
      "origin_file": "captainHook/server/hooks/engine/hook_physics_world_bounds.cpp",
      "excerpts": [
        {
          "first_line": 132,
          "last_line": 173,
          "text": "    void AttachPhysicsWorldBoundsHook()\n    {\n        if (!gBounds.enabled)\n            return;\n        if (gBounds.attached || gBounds.protectionPending)\n        {\n            CaptainHook::ShowErrorMessage(\"Physics world bounds patch is already installed.\");\n            return;\n        }\n        const auto base = reinterpret_cast<std::uintptr_t>(GetModuleHandleW(nullptr));\n        if (std::memcmp(reinterpret_cast<const void*>(base + kBoundsLoadsRva),\n                kExpectedBoundsLoads.data(), kExpectedBoundsLoads.size()) != 0)\n        {\n            CaptainHook::ShowErrorMessage(\"Can't install physics world bounds: BtWorld vector-load fingerprint mismatch.\");\n            return;\n        }\n        auto* address = reinterpret_cast<void*>(base + kBoundsRva);\n        if (std::memcmp(address, kOriginalBounds.data(), sizeof(Bounds)) != 0)\n        {\n            CaptainHook::ShowErrorMessage(\"Can't install physics world bounds: original constructor vectors differ.\");\n            return;\n        }\n        gBounds.address = address;\n        WriteBounds(gBounds.configured, true);\n    }\n\n    void DetachPhysicsWorldBoundsHook()\n    {\n        if (!gBounds.attached)\n        {\n            if (gBounds.protectionPending)\n                RestoreProtection();\n            return;\n        }\n        if (std::memcmp(gBounds.address, gBounds.configured.data(), sizeof(Bounds)) != 0)\n        {\n            CaptainHook::ShowErrorMessage(\"Can't detach physics world bounds: another writer changed the vectors.\");\n            return;\n        }\n        WriteBounds(kOriginalBounds, false);\n    }\n"
        }
      ]
    },
    {
      "id": "memory_write_and_protection",
      "origin_file": "captainHook/server/hooks/engine/hook_physics_world_bounds.cpp",
      "excerpts": [
        {
          "first_line": 56,
          "last_line": 71,
          "text": "        bool WriteBounds(const Bounds& values, bool attached)\n        {\n            DWORD previous = 0;\n            if (!VirtualProtect(gBounds.address, sizeof(Bounds), PAGE_READWRITE, &previous))\n            {\n                CaptainHook::ShowErrorMessage(\"Can't write physics world bounds: VirtualProtect failed.\");\n                return false;\n            }\n            // Keep the original protection across a failed restore and detach.\n            if (!gBounds.protectionPending)\n                gBounds.originalProtection = previous;\n            gBounds.protectionPending = true;\n            std::memcpy(gBounds.address, values.data(), sizeof(Bounds));\n            gBounds.attached = attached;\n            RestoreProtection();\n            return true;"
        }
      ]
    }
